# KIS Developers (한국투자증권 Open API) 인증 정보
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here

# 계좌번호: "12345678-01" 형식 (앞 8자리-뒤 2자리)
KIS_ACCOUNT_NO=00000000-01

# mock = 모의투자, real = 실전투자
KIS_ENV=mock

# 토큰 캐시 파일 경로 (선택)
KIS_TOKEN_CACHE_PATH=.kis_token_cache.json

# DART(전자공시시스템) OpenAPI 키 — https://opendart.fss.or.kr 에서 이메일로 즉시 발급
# 백테스트용 ROE/부채비율/영업이익 조회에 사용 (증권계좌 불필요)
DART_API_KEY=your_dart_api_key_here
